case_study_3/
cp3_vs_cp4/
box_prompt_benchmark/

# manuscript_figures/ is published, so a figure can be rerun: the notebooks, the
# README, and assets/ - the screenshots, plate photographs and Inkscape master
# that nothing here can regenerate. What a notebook writes is not published, so
# every output/ under it is ignored, analyses/output/ included.
manuscript_figures/**/output/

# ── Figures ─────────────────────────────────────────────────────────────────
